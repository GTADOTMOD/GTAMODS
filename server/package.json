  },
  "dependencies": {
    "@pump-fun/pump-sdk": "4.3.1",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.2"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
