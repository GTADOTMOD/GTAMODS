{
  "name": "rugr-server",
  "version": "0.1.0",
  "private": true,
  "description": "RUGR's server: Solana RPC for the app, coin pictures for launches, and the list of coins launched through RUGR.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
