<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>PumpPhone</AssemblyName>
    <RootNamespace>PumpPhone</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <Version>0.1.0</Version>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <!-- Lets this build without Visual Studio's targeting pack (e.g. dotnet build). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <None Include="../../companion/tools/phone-sim.html" Link="phone.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../companion/tools/art/*.jpg;../../companion/tools/art/icon.png;../../companion/tools/art/logo.png;../../companion/tools/art/wordmark.png" Link="art/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
